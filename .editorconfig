# Shared by shfmt (make shfmt, conform.nvim) and prettier, so the tab
# convention for shell scripts lives in one place instead of each tool's
# default.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,bash}]
indent_style = tab

# The waybar, sway and tmux scripts have no extension, so they are matched by
# directory. The sections below override this for the other files in there.
[waybar/*]
indent_style = tab

[tmux/scripts/*]
indent_style = tab

[sway/workspace-scroll]
indent_style = tab

[*.{nix,lua,toml,json,jsonc,yml,yaml,css,md}]
indent_style = space
indent_size = 2

[*.jq]
indent_style = space
indent_size = 4

# fish_indent always indents by four
[*.fish]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
