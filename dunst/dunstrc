[global]
    width = 300
    height = (0, 300)
    origin = top-right
    offset = (30, 20)
    notification_limit = 10
    font = Roboto 9
    format = "<b>%s</b>\n%b"
    alignment = left
    markup = full
    frame_color = "#bd93f9"
    frame_width = 1
    separator_color = frame
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 8
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    ellipsize = end
    highlight = "#bd93f9"
    show_age_threshold = 60
    show_indicators = yes
    word_wrap = yes
    sort = yes
    idle_threshold = 120
    history_length = 20
    sticky_history = yes
    follow = keyboard
    monitor = 0
    browser = xdg-open
    corner_radius = 8
    gap_size = 4
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#282a36cc"
    foreground = "#6272a4"
    timeout = 5

[urgency_normal]
    background = "#282a36cc"
    foreground = "#f8f8f2"
    timeout = 5

[urgency_critical]
    background = "#282a36cc"
    foreground = "#ff5555"
    override_pause_level = 100
    frame_color = "#ff5555"
    timeout = 0
