[user]
    name = Sascha Grunert
    email = sgrunert@redhat.com
    signingKey = 79C3DE73D9F8B626A81B990109D97D153EF94D93
[sendemail]
    smtpServer = smtp.corp.redhat.com
    smtpServerPort = 25
    smtpEncryption = none
[merge]
    tool = nvimdiff
    conflictstyle = zdiff3
    log = true
[mergetool]
    prompt = false
[push]
    autoSetupRemote = true
    useForceIfIncludes = true
[diff]
    tool = nvimdiff
    algorithm = histogram
    colorMoved = default
    renames = copies
    submodule = log
    wsErrorHighlight = all
[difftool]
    prompt = false
[core]
    editor = nvim
    excludesfile = ~/.gitignore_global
[help]
    autoCorrect = prompt
[column]
    ui = never
    branch = never
[commit]
    verbose = true
    gpgSign = true
[init]
    defaultBranch = main
[transfer]
    fsckObjects = true
    credentialsInUrl = warn
[pull]
    rebase = true
[fetch]
    prune = true
    parallel = 0
[rebase]
    autostash = true
    autosquash = true
    updateRefs = true
[branch]
    sort = -committerdate
[feature]
    manyFiles = true
[log]
    date = iso
[status]
    submoduleSummary = true
[submodule]
    fetchJobs = 0
[tag]
    sort = version:refname
    gpgSign = true
[stash]
    showPatch = true
[rerere]
    enabled = true
[interactive]
    diffFilter = delta --color-only --paging=never
[pager]
    branch = false
    diff = delta
    log = delta
    show = delta
    blame = delta
[delta]
    line-numbers = true
    navigate = true
    hyperlinks = true
    syntax-theme = Dracula
[maintenance]
    auto = true
    strategy = incremental
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
