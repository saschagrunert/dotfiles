[include]
    path = ~/.gitconfig_user
[merge]
    tool = nvimdiff
    conflictstyle = zdiff3
[mergetool]
    prompt = false
[push]
    default = upstream
    autoSetupRemote = true
[diff]
    tool = nvimdiff
    algorithm = histogram
    colorMoved = default
    renames = copies
    submodule = log
    wsErrorHighlight = all
[difftool]
    prompt = false
[http]
    postBuffer = 524288000
[core]
    editor = nvim
    excludesfile = ~/.gitignore_global
[column]
    ui = auto
[commit]
    verbose = true
[init]
    defaultBranch = main
[transfer]
    fsckObjects = true
[pull]
    rebase = true
[fetch]
    prune = true
    writeCommitGraph = true
    parallel = 0
[maintenance]
    strategy = incremental
[rebase]
    autostash = true
    autosquash = true
[branch]
    sort = -committerdate
[feature]
    manyFiles = true
[log]
    date = iso
[pack]
    threads = 0
[status]
    submoduleSummary = true
[submodule]
    fetchJobs = 0
[tag]
    sort = version:refname
[stash]
    showPatch = true
[rerere]
    enabled = 1
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[interactive]
    diffFilter = delta --color-only --paging=never
[pager]
    branch = false
    diff = delta
    log = delta
    show = delta
    blame = delta
[delta]
    line-numbers = true
    navigate = true
    hyperlinks = true
    syntax-theme = Dracula
[credential "https://github.com"]
    helper =
    helper = !/run/current-system/sw/bin/gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !/run/current-system/sw/bin/gh auth git-credential
