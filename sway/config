# use alt as modifier
set $mod Mod1
font "MesloLGSDZ Nerd Font 8"

# colors
set $bg         #282a36
set $selection  #44475a
set $fg         #f8f8f2
set $purple     #bd93f9
set $red        #ff5555

# Output configuration (dual 4K)
output HDMI-A-1 resolution 3840x2160@60Hz position 0,0 scale 1.5
output HDMI-A-2 resolution 3840x2160@60Hz position 2560,0 scale 1.5

# Wallpaper
output * bg ~/.dotfiles/wallpaper/blurred.jpg fill

# Input configuration
input type:pointer {
    accel_profile flat
}
input type:keyboard {
    xkb_layout us
    repeat_delay 300
    repeat_rate 50
}

seat * xcursor_theme Bibata-Original-Classic 24

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod normal

bindsym $mod+Return exec alacritty

# kill focused window
bindsym $mod+x kill

# start fuzzel (application launcher)
bindsym $mod+d exec fuzzel

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# split in horizontal orientation
bindsym $mod+z splith

# split in vertical orientation
bindsym $mod+n splitv

# cycle through layout modes
bindsym $mod+e layout toggle split tabbed stacking

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# toggle tiling / floating
bindsym $mod+Ctrl+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent/child container
bindsym $mod+a focus parent
bindsym $mod+Shift+a focus child

# scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

set $ws1 "1:󰖟"
set $ws2 "2:"

# switch to workspace
bindsym $mod+q workspace $ws1
bindsym $mod+w workspace $ws2

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9

# move focused container to workspace
bindsym $mod+Shift+q move container to workspace $ws1
bindsym $mod+Shift+w move container to workspace $ws2

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9

# reload sway configuration
bindsym $mod+p reload

# shutdown computer
bindsym $mod+Shift+s exec swaynag -t warning -m 'Shutdown the computer?' -b 'Yes' 'systemctl poweroff'

# resize window (you can also use the mouse for that)
mode "resize" {
    # These bindings trigger as soon as you enter the resize mode
    bindsym h resize shrink width 20 px
    bindsym j resize grow height 20 px
    bindsym k resize shrink height 20 px
    bindsym l resize grow width 20 px

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+i mode "resize"

bar {
    swaybar_command waybar
}

# Machine-specific: workspace to output mappings
workspace $ws1 output HDMI-A-1
workspace $ws2 output HDMI-A-2

# take a screenshot
bindsym $mod+v exec grim -g "$(slurp)" ~/downloads/screenshot-$(date +%Y%m%d-%H%M%S).png
bindsym $mod+Shift+v exec grim -g "$(slurp)" - | wl-copy
bindsym $mod+Ctrl+v exec grim ~/downloads/screenshot-$(date +%Y%m%d-%H%M%S).png

# move workspace to other output
bindsym $mod+Ctrl+h move workspace to output left
bindsym $mod+Ctrl+l move workspace to output right

# start application commands
bindsym $mod+Shift+c exec google-chrome-stable

bindsym $mod+y [urgent=latest] focus

# notification control
bindsym $mod+b exec makoctl dismiss
bindsym $mod+Shift+b exec makoctl restore

# floating window settings
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen
for_window [app_id="wdisplays"] floating enable, fullscreen disable
for_window [app_id=".blueman-manager-wrapped"] floating enable, fullscreen disable
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable, fullscreen disable
for_window [app_id="nm-connection-editor"] floating enable, fullscreen disable

# assign to workspaces
assign [app_id="google-chrome"] workspace $ws1
assign [app_id="Alacritty"] workspace $ws2

workspace_auto_back_and_forth yes

# other window settings
default_border none
default_floating_border pixel 1

swaynag_command swaynag --background $bg --text $fg --button-background $purple --border $selection --border-bottom $selection

#class                  border      backgr.     text        indicator   child_border
client.focused          $purple     $purple     $bg         $purple     $purple
client.focused_inactive $bg         $bg         $fg         $bg         $bg
client.unfocused        $bg         $bg         $fg         $bg         $bg
client.urgent           $red        $red        $bg         $red        $red

# idle management
exec swayidle -w \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"'

exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK
exec mako

exec alacritty -e fish -C 'tmux new-session -A -s work'
exec google-chrome-stable
