#!/usr/bin/env bash
set -euo pipefail

if [ "${1:-}" = "toggle" ]; then
	if systemctl --user is-active --quiet swayidle; then
		systemctl --user stop swayidle
		swaymsg "output * dpms on"
	else
		systemctl --user start swayidle
	fi
	exit 0
fi

if systemctl --user is-active --quiet swayidle; then
	text="<span color='#6272a4' size='large'>󰾪</span>"
	tooltip="Idle inhibitor: off"
	class="off"
else
	text="<span color='#f1fa8c' size='large'>󰅶</span>"
	tooltip="Idle inhibitor: on"
	class="on"
fi

printf '{"text": "%s", "tooltip": "%s", "class": "%s"}\n' "$text" "$tooltip" "$class"
