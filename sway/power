#!/usr/bin/env bash
set -euo pipefail

cpu_watts() {
	local rapl=""
	for p in /sys/class/powercap/intel-rapl:0 /sys/class/powercap/amd_rapl:0; do
		if [ -r "$p/energy_uj" ]; then
			rapl="$p"
			break
		fi
	done
	if [ -z "$rapl" ]; then
		echo "N/A"
		return
	fi

	local cache="${XDG_RUNTIME_DIR:-/tmp}/waybar-power-rapl"
	local now_uj
	now_uj=$(cat "$rapl/energy_uj")
	local now_ns
	now_ns=$(date +%s%N)

	if [ -f "$cache" ]; then
		local prev_uj prev_ns prev_watts
		read -r prev_uj prev_ns prev_watts <"$cache" || true
		if [ -z "${prev_uj:-}" ] || [ -z "${prev_ns:-}" ]; then
			echo "N/A"
			echo "$now_uj $now_ns N/A" >"$cache"
			return
		fi
		local d_uj=$((now_uj - prev_uj))
		if [ "$d_uj" -eq 0 ]; then
			echo "${prev_watts:-N/A}"
			return
		fi
		if [ "$d_uj" -lt 0 ]; then
			local max
			max=$(cat "$rapl/max_energy_range_uj")
			d_uj=$((d_uj + max))
		fi
		local d_ns=$((now_ns - prev_ns))
		if [ "$d_ns" -gt 0 ]; then
			local watts=$(((d_uj * 1000 + d_ns / 2) / d_ns))
			echo "$watts"
			echo "$now_uj $now_ns $watts" >"$cache"
		else
			echo "${prev_watts:-N/A}"
		fi
	else
		echo "N/A"
		echo "$now_uj $now_ns N/A" >"$cache"
	fi
}

gpu_watts() {
	for f in /sys/class/hwmon/hwmon*/name; do
		if [ "$(cat "$f" 2>/dev/null)" = "amdgpu" ]; then
			local dir
			dir=$(dirname "$f")
			local device
			device=$(readlink -f "$dir/device" 2>/dev/null)
			if [[ "$device" == */0000:03:00.0 ]]; then
				local val
				val=$(cat "$dir/power1_average" 2>/dev/null) || val=0
				echo $(((val + 500000) / 1000000))
				return
			fi
		fi
	done
	echo "0"
}

cpu=$(cpu_watts)
gpu=$(gpu_watts)

cpu_label="${cpu}W"
if [ "$cpu" = "N/A" ]; then
	cpu_label="-"
fi

text="<span color='#f1fa8c' size='large'>󰻠</span> ${cpu_label}  <span color='#ffb86c' size='large'>󰢮</span> ${gpu}W"
tooltip="CPU: ${cpu_label}\nGPU: ${gpu}W"

printf '{"text": "%s", "tooltip": "%s"}\n' "$text" "$tooltip"
