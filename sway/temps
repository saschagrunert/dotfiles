#!/usr/bin/env bash
set -euo pipefail

find_temp() {
	local name=$1
	for f in /sys/class/hwmon/hwmon*/name; do
		if [ "$(cat "$f" 2>/dev/null)" = "$name" ]; then
			local dir
			dir=$(dirname "$f")
			local val
			val=$(cat "$dir/temp1_input" 2>/dev/null) || val=0
			echo $((val / 1000))
			return
		fi
	done
	echo 0
}

find_gpu_temp() {
	for f in /sys/class/hwmon/hwmon*/name; do
		if [ "$(cat "$f" 2>/dev/null)" = "amdgpu" ]; then
			local dir
			dir=$(dirname "$f")
			local device
			device=$(readlink -f "$dir/device" 2>/dev/null)
			if [[ "$device" == */0000:03:00.0 ]]; then
				local val
				val=$(cat "$dir/temp1_input" 2>/dev/null) || val=0
				echo $((val / 1000))
				return
			fi
		fi
	done
	echo 0
}

cpu=$(find_temp k10temp)
gpu=$(find_gpu_temp)
nvme=$(find_temp nvme)

class=""
if [ "$cpu" -ge 85 ] || [ "$gpu" -ge 90 ] || [ "$nvme" -ge 70 ]; then
	class="critical"
elif [ "$cpu" -ge 75 ] || [ "$gpu" -ge 80 ] || [ "$nvme" -ge 60 ]; then
	class="warning"
fi

text="<span color='#f1fa8c' size='large'>󰻠</span> ${cpu}°C"
text+="  <span color='#ffb86c' size='large'>󰢮</span> ${gpu}°C"
text+="  <span color='#8be9fd' size='large'>󰆼</span> ${nvme}°C"

tooltip="CPU: ${cpu}°C\nGPU: ${gpu}°C\nNVMe: ${nvme}°C"

printf '{"text": "%s", "tooltip": "%s", "class": "%s"}\n' "$text" "$tooltip" "$class"
