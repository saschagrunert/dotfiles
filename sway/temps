#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

# shellcheck source-path=SCRIPTDIR
# shellcheck source=hwmon.sh
. "$(dirname "$0")/hwmon.sh"

cpu=$(($(hwmon_value k10temp temp1_input) / 1000))
gpu=$(($(hwmon_value amdgpu temp1_input) / 1000))
nvme=$(($(hwmon_value nvme temp1_input) / 1000))

class=""
if [ "$cpu" -ge 85 ] || [ "$gpu" -ge 90 ] || [ "$nvme" -ge 70 ]; then
	class="critical"
elif [ "$cpu" -ge 75 ] || [ "$gpu" -ge 80 ] || [ "$nvme" -ge 60 ]; then
	class="warning"
fi

text=$(printf "<span color='#f1fa8c' size='large'>󰻠</span> %3d°C" "$cpu")
text+=$(printf "  <span color='#ffb86c' size='large'>󰢮</span> %3d°C" "$gpu")
text+=$(printf "  <span color='#8be9fd' size='large'>󰆼</span> %3d°C" "$nvme")

tooltip="CPU:  $(printf '%3d' "$cpu")°C\nGPU:  $(printf '%3d' "$gpu")°C\nNVMe: $(printf '%3d' "$nvme")°C"

printf '{"text": "%s", "tooltip": "%s", "class": "%s"}\n' "$text" "$tooltip" "$class"
