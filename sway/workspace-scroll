#!/usr/bin/env bash
set -euo pipefail

direction=${1:?usage: workspace-scroll <next|prev>}
workspaces=$(swaymsg -t get_workspaces)

focused_num=$(echo "$workspaces" | jq '.[] | select(.focused==true) | .num')
[ -z "$focused_num" ] && exit 0

focused_output=$(echo "$workspaces" | jq -r '.[] | select(.focused==true) | .output')

if [ "$direction" = "next" ]; then
	if [ "$focused_num" -lt 1 ]; then
		swaymsg workspace 1
	elif [ "$focused_num" -lt 5 ]; then
		swaymsg workspace "$((focused_num + 1))"
	fi
elif [ "$direction" = "prev" ]; then
	if [ "$focused_num" -gt 1 ]; then
		swaymsg workspace "$((focused_num - 1))"
	elif [ "$focused_num" -le 1 ]; then
		symbol=$(echo "$workspaces" | jq -r --arg out "$focused_output" '.[] | select(.output==$out and .num==0) | .name')
		if [ -n "$symbol" ]; then
			swaymsg "workspace \"$symbol\""
		fi
	fi
fi
