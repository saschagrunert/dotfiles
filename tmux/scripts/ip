#!/usr/bin/env bash
set -euo pipefail

cache="${XDG_RUNTIME_DIR:-/tmp}/tmux-ip-${UID}"
wan_cache="${cache}-wan.txt"
lan_cache="${cache}-lan.txt"
now=$(date +%s)

lan_ip=""
if [ -f "$lan_cache" ]; then
	last=$(stat -c "%Y" "$lan_cache")
	if [ $((now - last)) -lt 30 ]; then
		lan_ip=$(cat "$lan_cache")
	fi
fi
if [ -z "$lan_ip" ]; then
	lan_ip=$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oP 'src \K\S+' || true)
	[ -n "$lan_ip" ] && echo "$lan_ip" >"$lan_cache"
fi

wan_ip=""
if [ -f "$wan_cache" ]; then
	last=$(stat -c "%Y" "$wan_cache")
	if [ $((now - last)) -lt 900 ]; then
		wan_ip=$(cat "$wan_cache")
	fi
fi
if [ -z "$wan_ip" ]; then
	if wan_ip=$(curl --max-time 2 -s https://whatismyip.akamai.com/); then
		echo "$wan_ip" >"$wan_cache"
	elif [ -f "$wan_cache" ]; then
		wan_ip=$(cat "$wan_cache")
	fi
fi

echo "${wan_ip} / ${lan_ip:-N/a}"
