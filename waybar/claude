#!/usr/bin/env bash
# Claude plan usage: the current session and today's share of the week on the
# bar, a meter for every rate limit with the time it resets, today's share and
# the running Claude Code sessions in the tooltip. The limits come from the
# usage endpoint Claude Code shows in /usage, called with its OAuth token,
# which does not count against them.
set -euo pipefail
shopt -s nullglob

# shellcheck source-path=SCRIPTDIR
# shellcheck source=tooltip.sh
. "$(dirname "$0")/tooltip.sh"

# The limits change slowly and the endpoint is rate limited itself, which
# Claude Code calls as well, so they are fetched far less often than the
# sessions are read. Every rejected fetch doubles the wait, up to $BACKOFF.
FETCH=300
BACKOFF=1800
URL=https://api.anthropic.com/api/oauth/usage
# Fields are separated by the unit separator. Unlike a tab it keeps empty
# fields apart when read, and the fields never contain it.
US=$'\x1f'
ICON=
ORANGE="#ffb86c"
WEEK_ICON=󰨳
# The weekdays the week is shared across, as numbered by %u from Monday.
WORKDAYS=12345

# The subscription lives in its own config directory, ~/.claude is set up for
# Vertex AI and has no credentials.
credentials=""
for dir in "${CLAUDE_CONFIG_DIR:-}" "$HOME/.claude-max" "$HOME/.claude"; do
	[ -n "$dir" ] && [ -f "$dir/.credentials.json" ] && {
		credentials=$dir/.credentials.json
		break
	}
done

# The last limits fetched, each "name pct reset active" with the reset
# in epoch seconds or 0, the weekly usage by product, the times of
# the last fetch and the last successful one, the wait until the next one, and
# why the last fetch failed.
declare -a limits=()
breakdown="" fetched=0 updated=0 wait=$FETCH error=""

# They outlive the script, so a waybar reload neither fetches again nor starts
# without values.
state=""
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
	state=$XDG_RUNTIME_DIR/waybar/claude.state
	mkdir -p "${state%/*}"
	# shellcheck source=/dev/null
	[ -f "$state" ] && . "$state"
fi

# Fetch the limits. Claude Code renews the token, which lasts a few hours, so
# an expired one means it has not run for a while. The token goes to curl on
# stdin to keep it out of the process list.
fetch() {
	local token="" expires=0 response code rc=0
	if [ -z "$credentials" ]; then
		error="no credentials, log in to Claude Code"
		return
	fi
	IFS=$US read -r token expires < <(jq -r '.claudeAiOauth // {}
		| [.accessToken // "", .expiresAt // 0] | map(tostring) | join("\u001f")' \
		"$credentials" 2>/dev/null) || true
	if [ -z "$token" ]; then
		error="no OAuth token, log in to Claude Code"
		return
	elif ((expires / 1000 <= EPOCHSECONDS)); then
		error="token expired, start Claude Code to renew it"
		return
	fi
	response=$(curl -s -m 10 -w '\n%{http_code}' -K - "$URL" \
		-H "anthropic-beta: oauth-2025-04-20" <<<"header = \"Authorization: Bearer $token\"") || rc=$?
	# A request that could not resolve or connect never reached the server, so
	# it is tried again on the next update to show the limits soon after going
	# online. Any other failure, like a timeout, may have reached it and is
	# tried again after a minute.
	case $rc in
	0) ;;
	6 | 7)
		error="offline" fetched=0
		return
		;;
	*)
		error="request failed" fetched=$((EPOCHSECONDS - wait + 60))
		return
		;;
	esac
	code=${response##*$'\n'}
	if [ "$code" = 429 ]; then
		wait=$((wait * 2 > BACKOFF ? BACKOFF : wait * 2))
		error="rate limited, next try in $((wait / 60))m"
		return
	elif [ "$code" != 200 ]; then
		error="HTTP $code"
		return
	fi
	# Scoped limits are named after their model or surface, each either an
	# object or a name. Names come from the server, so only plain characters
	# get into the tooltip. The weekly usage by product comes first, where the
	# command substitution keeps it when empty, leaving out the unused ones.
	local out row name pct reset active
	local -a rows
	if ! out=$(jq -r 'def plain: tostring | gsub("[^A-Za-z0-9 ._%-]"; "");
		([.seven_day_breakdown.rows // [] | .[] | select(.percent > 0)
			| "\(.display_name) \(.percent | floor)%" | plain] | join("  ")),
		(.limits[] | [
			(if .kind == "session" then "Session"
			 elif .kind == "weekly_all" then "Week"
			 else (.scope.model? | objects | .display_name)
				// (.scope.surface? | objects | .display_name)
				// (.scope.surface? | strings) // .kind end
			 | plain | .[:20] | if . == "" then "Limit" else . end),
			(.percent // 0 | floor), (.resets_at // "" | gsub("[^0-9TZ:.+-]"; "")),
			.is_active == true]
			| map(tostring) | join("\u001f"))' \
		<<<"${response%$'\n'*}" 2>/dev/null); then
		error="unexpected response"
		return
	fi
	mapfile -t rows <<<"$out"
	if [ ${#rows[@]} -lt 2 ]; then
		error="no limits in response"
		return
	fi
	breakdown=${rows[0]:0:WIDTH}
	limits=()
	for row in "${rows[@]:1}"; do
		IFS=$US read -r name pct reset active <<<"$row"
		# An empty date would be midnight today.
		if [ -z "$reset" ] || ! reset=$(date -d "$reset" +%s 2>/dev/null); then
			reset=0
		fi
		limits+=("$name$US$pct$US$reset$US$active")
	done
	updated=$EPOCHSECONDS wait=$FETCH error=""
}

# Share the week, $1 percent used and resetting at epoch $2, evenly across its
# working days. Those are the days starting within it, and with five of them
# each takes 20% in turn. The evening of the last reset counts as the first
# one when it falls on a working day. Set days to their number, dayno to
# today's position among them or 0 on a day off, and used to what the week
# used beyond the shares of the days before today, in percent of a share, which
# is negative while they left some over. Set day to the percentage of today's
# share used, empty on a day off, and balance to the shares the days before
# left over, or overdrew on a day off. Today's share only fills once the
# earlier ones did.
#
# The days are walked back from noon of the last one, which a change to or
# from daylight saving time keeps on the same date.
budget() {
	local pct=$1 reset=$2 today date wday hour done=0 i t
	printf -v today '%(%F)T' -1
	printf -v hour '%(%H)T' $((reset - 1))
	days=0 dayno=0 used=0 day="" balance=0
	for ((i = 7; i >= 0; i--)); do
		t=$((reset - 1 + (12 - 10#$hour) * 3600 - i * 86400))
		printf -v wday '%(%u)T' "$t"
		[[ $WORKDAYS == *$wday* ]] || continue
		printf -v date '%(%F)T' "$t"
		if ((i == 7)); then
			[ "$date" = "$today" ] && dayno=1
			continue
		fi
		days=$((days + 1))
		[[ $date > $today ]] || done=$days
		[ "$date" = "$today" ] && dayno=$days
	done
	((days)) || {
		dayno=0
		return 0
	}
	if ((dayno)); then
		used=$((pct * days - (dayno - 1) * 100))
		day=$((used < 0 ? 0 : used))
	else
		used=$((pct * days - done * 100))
	fi
	balance=$((${day:-0} - used))
}

# Print when epoch $1 comes, as the time of day if that is today and with the
# weekday otherwise, followed by how long until then.
reset_time() {
	local left=$(($1 - EPOCHSECONDS)) day today when
	((left < 0)) && left=0
	printf -v day '%(%F)T' "$1"
	printf -v today '%(%F)T' -1
	if [ "$day" = "$today" ]; then
		printf -v when '%(%H:%M)T' "$1"
	else
		printf -v when '%(%a %H:%M)T' "$1"
	fi
	if ((left >= 86400)); then
		printf '%s\t%dd %dh' "$when" $((left / 86400)) $((left % 86400 / 3600))
	elif ((left >= 3600)); then
		printf '%s\t%dh %dm' "$when" $((left / 3600)) $((left % 3600 / 60))
	else
		printf '%s\t%dm' "$when" $(((left + 59) / 60))
	fi
}

# Print the model of the last reply in transcript $1 and its effort, separated
# by a tab, like "Opus 5.5" and "high". The transcript is read from its end,
# where a line still being written may be cut off, so lines that do not parse
# are skipped, like replies Claude Code makes up itself, which have no real
# model.
transcript_model() {
	tac -- "$1" 2>/dev/null | grep -a -m5 -F '"model":"claude-' | jq -nrR '
		first(inputs | fromjson? | select(.type == "assistant")
			| [(.message.model | strings | ltrimstr("claude-") | sub("\\[.*"; "")
				| sub("-[0-9]{8}$"; "") | split("-")
				| (.[0][:1] | ascii_upcase) + .[0][1:] + " " + (.[1:] | join(".")) | .[:20]),
				(.effort // "" | tostring | .[:8])]
			| map(gsub("[^A-Za-z0-9 ._-]"; "") | rtrimstr(" ")) | join("\t"))' \
		2>/dev/null || true
}

# Print "dir status model effort" separated by tabs for every running Claude Code
# session of the subscription. A session file stays behind when Claude Code
# crashes, so its process must still be the one that started, with the same
# start time. Each file is read on its own, so one caught while being written
# only leaves out its own session. Directories may contain anything, so the
# characters breaking the tooltip are dropped.
sessions() {
	[ -n "$credentials" ] || return 0
	local file pid start dir status stat id transcript model
	for file in "${credentials%/*}"/sessions/*.json; do
		IFS=$US read -r pid start dir status id < <(jq -r '[.pid, .procStart, .cwd, .status, .sessionId]
			| map(. // "" | tostring | gsub("[[:cntrl:]\"\\\\<>&]"; ""))
			| .[4] |= gsub("[^A-Za-z0-9-]"; "") | join("\u001f")' \
			"$file" 2>/dev/null) || continue
		stat=$(cat "/proc/$pid/stat" 2>/dev/null) || continue
		stat=${stat##*) }
		read -ra stat <<<"$stat"
		[ -n "$start" ] && [ "${stat[19]}" = "$start" ] || continue
		dir=${dir:-?} dir=${dir/#"$HOME"/"~"}
		status=${status:-?}
		model=""
		[ -n "$id" ] && for transcript in "${credentials%/*}"/projects/*/"$id".jsonl; do
			model=$(transcript_model "$transcript")
		done
		printf '%s\t%s\t%s\n' "$dir" "${status:0:12}" "$model"
	done
}

emit() {
	if ((EPOCHSECONDS - fetched >= wait)); then
		fetched=$EPOCHSECONDS
		fetch
		[ -z "$state" ] || declare -p limits breakdown fetched updated wait error >"$state"
	fi

	# Each limit shows its name with the reset time on the right, then its
	# meter. A small blank line keeps them apart. The limit the server marks
	# as active is labeled, and the weekly one lists its usage by product. A
	# limit fetched before its reset has started over since, and its usage is
	# unknown until the next fetch, since chats count against it too.
	#
	# Today's share of the week follows the weekly limit, with the meter of
	# what it used and how far ahead or behind the days before left it.
	#
	# The bar shows the session and today's share, followed by the week in
	# parentheses once it warns, and warns when either does. A model or surface
	# running out leaves the rest of the plan usable, so it is left out. The
	# server already warns from 75%, which is early for limits that reset on
	# their own, so a warning starts at 95%.
	# A state saved before the severity was dropped has a fifth field.
	local session="" week="" class="" tooltip row name pct reset active
	local shown when left right gap tag warn i days=0 dayno=0 used=0 day="" balance=0
	tooltip="${ header "Claude usage";}"
	for row in "${limits[@]}"; do
		IFS=$US read -r name pct reset active _ <<<"$row"
		printf -v shown '%3d%%' "$pct"
		warn=$((pct >= 95))
		if ((reset > 0 && reset <= EPOCHSECONDS)); then
			pct=0 shown=" --%" reset=0 warn=0
		fi
		case $name in Session | Week) ((warn)) && class=warning ;; esac
		[ "$name" = Session ] && [ "$shown" != " --%" ] && session=$shown
		[ "$name" = Week ] && ((warn)) && week=" ($WEEK_ICON $pct%)"
		[ "$row" = "${limits[0]}" ] || tooltip+="\n<span size='xx-small'> </span>"
		right="" gap="" tag=""
		[ "$active" = true ] && tag=" active"
		if ((reset > 0)); then
			IFS=$'\t' read -r when left <<<"${ reset_time "$reset";}"
			right="${ label Resets;} $when ${ label in;} $left"
			for ((i = ${#name} + ${#tag} + ${#when} + ${#left} + 12; i < WIDTH; i++)); do gap+=" "; done
		fi
		tooltip+="\n<b>$name</b>${tag:+ ${ label "${tag# }";}}${right:+$gap $right}"
		tooltip+="\n<b>$shown</b> ${ meter "$pct" $((WIDTH - 5));}"
		[ "$name" = Week ] || continue
		[ -n "$breakdown" ] && tooltip+="\n${ label "$breakdown";}"
		((reset > 0)) && budget "$pct" "$reset"
		((days)) || continue
		if ((dayno)); then
			right="${ label Day;} $dayno ${ label of;} $days" left="Day $dayno of $days"
		else
			right="${ label "Day off";}" left="Day off"
		fi
		gap=""
		for ((i = ${#left} + 6; i < WIDTH; i++)); do gap+=" "; done
		tooltip+="\n<span size='xx-small'> </span>\n<b>Today</b>$gap $right"
		if [ -n "$day" ]; then
			printf -v shown '%3d%%' "$day"
			tooltip+="\n<b>$shown</b> ${ meter "$day" $((WIDTH - 5));}"
		fi
		shown=${ fraction 100 "$days";} shown=${shown%.0}%
		tooltip+="\n${ label Share;} $shown ${ label "of the week";}"
		if ((balance > 0)); then
			right=Ahead left=$balance%
		elif ((balance < 0)); then
			right=Behind left=$((-balance))%
		else
			continue
		fi
		gap=""
		for ((i = ${#shown} + ${#right} + ${#left} + 20; i < WIDTH; i++)); do gap+=" "; done
		tooltip+="$gap ${ label "$right";} $left"
	done

	# Today's share follows the session after a slash, which stays while the
	# session is unknown to tell them apart. The balance counts against it, so
	# a share left over from the days before makes it negative and one
	# overdrawn on a day off positive, colored by which it is.
	local today="" share
	if ((days)) && { [ -n "$day" ] || ((balance)); }; then
		share="$used%"
		[ -z "$error" ] && ((balance)) &&
			share="<span color='${GRADIENT[balance > 0 ? 0 : 9]}'>$share</span>"
		today=" / $share"
	fi

	# Old values are dimmed and lose their class while fetching fails. Without
	# any value the bar only shows the icon, dimmed as well.
	local text="${session:+ $session}$today$week" color=$ORANGE
	if [ -z "$text" ]; then
		color=$DIM class=""
	elif [ -n "$error" ]; then
		text="<span color='$DIM'>$text</span>" class=""
	fi
	text="<span color='$color' size='large'>$ICON</span>$text"

	if [ -n "$error" ]; then
		((${#limits[@]})) && tooltip+="\n"
		if ((updated)); then
			tooltip+="\n${ label "Updated ${ printf '%(%H:%M)T' "$updated";}, $error";}"
		else
			tooltip+="\n${ label "No data, $error";}"
		fi
	fi

	# Each session shows its directory, shortened from the left to fit, and
	# its status on the right. Below come the model of its last reply, which a
	# new session does not have yet, and its effort on the right. A small
	# blank line keeps the sessions apart.
	local -a running
	mapfile -t running < <(sessions)
	if [ ${#running[@]} -gt 0 ]; then
		local dir status model effort color max n
		tooltip+="\n\n${ header Sessions;}"
		for n in "${!running[@]}"; do
			IFS=$'\t' read -r dir status model effort <<<"${running[n]}"
			case $status in
			busy) color=${GRADIENT[0]} ;;
			idle) color=$DIM ;;
			*) color=${GRADIENT[7]} ;;
			esac
			max=$((WIDTH - ${#status} - 3))
			((max < 2)) && max=2
			((${#dir} > max)) && dir="…${dir: -$((max - 1))}"
			gap=""
			for ((i = ${#dir} + ${#status} + 3; i < WIDTH; i++)); do gap+=" "; done
			((n)) && tooltip+="\n<span size='xx-small'> </span>"
			tooltip+="\n<span color='$color'>●</span> $dir$gap ${ label "$status";}"
			[ -n "$model" ] || continue
			gap=""
			for ((i = ${#model} + ${#effort} + 3; i < WIDTH; i++)); do gap+=" "; done
			tooltip+="\n  $model${effort:+$gap ${ label "$effort";}}"
		done
	fi

	printf '{"text": "%s", "tooltip": "%s", "class": "%s"}\n' "$text" "${ spaced "$tooltip";}" "$class"
}

run emit "${1:-}"
