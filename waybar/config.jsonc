{
  "layer": "top",
  "position": "top",
  "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
  "modules-right": [
    "group/hardware",
    "network",
    "disk",
    "memory",
    "group/load",
    "group/audio",
    "privacy",
    "idle_inhibitor",
    "custom/dnd",
    "custom/failed-units",
    "custom/nix-updates",
    "clock#time",
    "clock#date",
    "tray",
  ],
  "sway/window": {
    "max-length": 300,
    "on-scroll-up": "~/.config/sway/workspace-scroll prev",
    "on-scroll-down": "~/.config/sway/workspace-scroll next",
  },
  "sway/mode": {
    "format": "<span color='#ff5555' size='large'>󰩨</span> {}",
  },
  "sway/workspaces": {
    "format": "<span size='x-large'>{name}</span>",
    "disable-scroll-wraparound": true,
  },
  "disk": {
    "path": "/",
    "format": "<span color='#50fa7b' size='large'>󰋊</span> {percentage_used:3}% ({free} free)",
    "tooltip-format": "{used} / {total}",
    "interval": 30,
  },
  // The drawers show their first module and expand to the left on hover, so
  // the visible module does not move. Temperatures stay visible, power and fans
  // expand.
  "group/hardware": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "transition-left-to-right": false,
    },
    "modules": ["custom/temps", "custom/power", "custom/fans"],
  },
  // CPU load stays visible, GPU load expands on hover
  "group/load": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "transition-left-to-right": false,
    },
    "modules": ["cpu", "custom/gpu"],
  },
  // Output volume stays visible, the microphone expands on hover
  "group/audio": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "transition-left-to-right": false,
    },
    "modules": ["pulseaudio", "pulseaudio#source"],
  },
  "custom/temps": {
    "exec": "~/.config/waybar/temps",
    "return-type": "json",
    "interval": 5,
  },
  "custom/fans": {
    "exec": "~/.config/waybar/fans",
    "return-type": "json",
    "interval": 5,
  },
  "custom/power": {
    "exec": "~/.config/waybar/power",
    "return-type": "json",
    "interval": 5,
  },
  "network": {
    "format-ethernet": "<span color='#8be9fd' size='large'>󰈀</span> <span color='#6272a4'>󰇚</span> {bandwidthDownBytes:>9} <span color='#6272a4'>󰕒</span> {bandwidthUpBytes:>9}",
    "format-wifi": "<span color='#8be9fd' size='large'>{icon}</span> <span color='#6272a4'>󰇚</span> {bandwidthDownBytes:>9} <span color='#6272a4'>󰕒</span> {bandwidthUpBytes:>9}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-disconnected": "<span color='#6272a4' size='large'>󰤭</span> disconnected",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}",
    "tooltip-format-wifi": "SSID: {essid} ({signalStrength}%)\nBSSID: {bssid}\n{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}\nFrequency: {frequency}GHz",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 5,
    "on-click": "nm-connection-editor",
  },
  "memory": {
    "format": "<span color='#ff79c6' size='large'>󰘚</span> {used:2.0f}GB ({percentage:3}%)",
    "tooltip-format": "RAM:  {used:0.1f}GB / {total:0.1f}GB\nSwap: {swapUsed:0.1f}GB / {swapTotal:0.1f}GB",
    "interval": 5,
    "states": { "warning": 80, "critical": 95 },
  },
  "cpu": {
    "format": "<span color='#f1fa8c' size='large'>󰾆</span> {usage:3}% ({avg_frequency:0.1f}GHz)",
    "interval": 5,
    "states": { "warning": 80, "critical": 95 },
  },
  "custom/gpu": {
    "exec": "~/.config/waybar/gpu",
    "return-type": "json",
    "interval": 5,
  },
  "privacy": {
    "icon-size": 14,
    "modules": [{ "type": "screenshare" }, { "type": "audio-in" }],
  },
  "pulseaudio": {
    "format": "<span color='#50fa7b' size='large'>{icon}</span> {volume:3}%",
    "format-muted": "<span color='#6272a4' size='large'>󰖁</span> <span color='#6272a4'>{volume:3}%</span>",
    "format-icons": {
      "default": ["󰖀", "󰕾"],
    },
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
  },
  "pulseaudio#source": {
    "format": "{format_source}",
    "format-muted": "{format_source}",
    "format-source": "<span color='#ff79c6' size='large'>󰍬</span> {volume:3}%",
    "format-source-muted": "<span color='#6272a4' size='large'>󰍭</span> <span color='#6272a4'>{volume:3}%</span>",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
  },
  // The signal refreshes the module right after a click. The interval stays,
  // an interval of 0 together with a signal broke all tooltips before.
  "custom/dnd": {
    "exec": "~/.config/waybar/dnd",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "on-click": "makoctl mode -t do-not-disturb && pkill -RTMIN+8 waybar",
    "on-click-right": "makoctl dismiss -a",
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "<span color='#f1fa8c' size='large'>󰅶</span>",
      "deactivated": "<span color='#6272a4' size='large'>󰾪</span>",
    },
    "tooltip-format-activated": "Idle inhibitor: on",
    "tooltip-format-deactivated": "Idle inhibitor: off",
  },
  "custom/failed-units": {
    "exec": "~/.config/waybar/failed-units",
    "return-type": "json",
    "interval": 10,
  },
  "custom/nix-updates": {
    "exec": "~/.config/waybar/nix-updates",
    "return-type": "json",
    "interval": 1800,
    "signal": 9,
    "on-click": "~/.config/waybar/nix-updates --force && pkill -RTMIN+9 waybar",
  },
  "clock#time": {
    "format": "<span color='#bd93f9' size='large'>󰅐</span> {:%H:%M:%S}",
    "tooltip": false,
    "interval": 1,
    "on-scroll-up": "~/.config/sway/workspace-scroll prev",
    "on-scroll-down": "~/.config/sway/workspace-scroll next",
  },
  "clock#date": {
    "format": "<span color='#bd93f9' size='large'>󰃭</span> {:%a %d %b W%V}",
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "months": "<span color='#f8f8f2'><b>{}</b></span>",
        "weeks": "<span color='#6272a4'>{}</span>",
        "weekdays": "<span color='#bd93f9'><b>{}</b></span>",
        "today": "<span color='#ff79c6'><b>{}</b></span>",
      },
    },
    "interval": 60,
    "on-scroll-up": "~/.config/sway/workspace-scroll prev",
    "on-scroll-down": "~/.config/sway/workspace-scroll next",
  },
  "tray": {
    "spacing": 8,
  },
}
