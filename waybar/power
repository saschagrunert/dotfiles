#!/usr/bin/env bash
# CPU and GPU power draw with a history graph of the total and meters against
# the power limits in the tooltip.
set -euo pipefail
shopt -s nullglob

# shellcheck source-path=SCRIPTDIR
# shellcheck source=hwmon.sh
. "$(dirname "$0")/hwmon.sh"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=tooltip.sh
. "$(dirname "$0")/tooltip.sh"

RAPL=${RAPL_ROOT:-/sys/class/powercap/intel-rapl:0}
# Package power limit (PPT) of the Ryzen 7 9800X3D in watts. AMD exposes no
# RAPL constraints, so it cannot be read from sysfs.
CPU_LIMIT=162

declare -a history=() watts=()

# Print the CPU package energy counter in microjoules, or nothing without
# RAPL.
energy() {
	sensor_value "$RAPL/energy_uj"
}

row() {
	local name=$1 value=$2 limit=$3
	printf '%s %5s' "${ label "$name";}" "${ reading "$value" W;}"
	if [ -n "$value" ] && [ -n "$limit" ] && [ "$limit" -gt 0 ]; then
		printf ' %s' "${ meter "${ percent "$value" "$limit";}" $((WIDTH - 12));}"
	fi
}

# Print watts $1 as a percentage of limit $2.
percent() {
	local pct=0
	[ "$2" -gt 0 ] && pct=$((($1 * 100 + $2 / 2) / $2))
	((pct > 100)) && pct=100
	echo "$pct"
}

emit() {
	local prev_uj=$uj prev_time=$time
	uj=$(energy)
	time=${ sample_time;}

	# Missing samples or an unknown wrap range cannot establish a power reading.
	local cpu="" d_uj d_us=$((time - prev_time)) max
	if [ -n "$uj" ] && [ -n "$prev_uj" ] && [ "$d_us" -gt 0 ]; then
		d_uj=$((uj - prev_uj))
		if [ "$d_uj" -lt 0 ]; then
			max=${ sensor_value "$RAPL/max_energy_range_uj";}
			[ -z "$max" ] || d_uj=$((d_uj + max))
		fi
		[ "$d_uj" -lt 0 ] || cpu=$(((d_uj + d_us / 2) / d_us))
	fi

	local gpu gpu_limit
	gpu=${ hwmon_value amdgpu power1_average fan1_input;}
	gpu_limit=${ hwmon_value amdgpu power1_cap fan1_input;}
	[ -z "$gpu" ] || gpu=$(((gpu + 500000) / 1000000))
	[ -z "$gpu_limit" ] || gpu_limit=$(((gpu_limit + 500000) / 1000000))
	local total=""
	if [ -n "$cpu" ] && [ -n "$gpu" ]; then
		total=$((cpu + gpu))
		record watts "$total"
	else
		watts=()
	fi
	if [ -n "$total" ] && [ -n "$gpu_limit" ]; then
		record history "${ percent "$total" $((CPU_LIMIT + gpu_limit));}"
	else
		history=()
	fi

	local sum=0 peak=0 w
	for w in "${watts[@]}"; do
		sum=$((sum + w))
		((w > peak)) && peak=$w
	done

	# The unit is shown once at the end to keep the module narrow.
	local text tooltip
	text=${ printf "<span color='#f1fa8c' size='large'>󰻠</span> %3s  <span color='#ffb86c' size='large'>󰢮</span> %3s W" "${cpu:-N/A}" "${gpu:-N/A}";}

	tooltip="${ header Power;}\n${ graph "" "${history[@]}";}\n"
	tooltip+="${ row "CPU  " "$cpu" "$CPU_LIMIT";}\n${ row "GPU  " "$gpu" "$gpu_limit";}\n"
	tooltip+="${ label Total;} <b>${ reading "$total" W;}</b>"
	if ((${#watts[@]})); then
		tooltip+="  ${ label Average;} $((sum / ${#watts[@]}))W  ${ label Peak;} ${peak}W"
	fi

	printf '{"text": "%s", "tooltip": "%s"}\n' "$text" "${ spaced "$tooltip";}"
}

uj=$(energy)
time=${ sample_time;}
run emit "${1:-}"
