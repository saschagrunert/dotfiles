#!/usr/bin/env bash
# Run the continuous waybar script named $1 only once while several bars run,
# like the old and new bar overlapping during a sway reload. Each would
# otherwise run its own copy, sampling the same data twice or polling a rate
# limited endpoint twice. The bar holding the lock runs the script and
# publishes every line to a file, the other bars print that file whenever it
# changes. A bar that goes away releases the lock, and another one takes over.
set -euo pipefail

# setpriv arms the kernel's parent-death signal before this worker starts.
# Check the expected parent to cover it exiting before that signal was armed.
# GNU timeout forwards TERM to the producer's whole group, including commands
# the shell is waiting for, and escalates if needed. Zero disables its timer.
if [ "${1:-}" = --producer ]; then
	[ "$PPID" -eq "$2" ] || exit 0
	exec timeout --kill-after=5 0 "$3"
fi

name=${1:?usage: shared <script>}
[[ "$name" =~ ^[a-z-]+$ ]] || {
	echo "invalid script: $name" >&2
	exit 1
}
script=$(dirname "$0")/$name
dir=${XDG_RUNTIME_DIR:?}/waybar
out=$dir/$name.json
mkdir -p "$dir"
exec 8>"$dir/$name.lock"

# The script and its children must not hold the lock, or it would outlive this
# bar. The lines are read here and not in a pipeline, whose subshell would keep
# the lock and the file after this bar is gone, until the script prints again.
# The script stops with this bar, and a line goes to the bar before the file,
# so nothing replaces the file once the bar is gone. Each line replaces the
# file in one rename, so followers never read half of one. Retry a producer
# that exits, with a capped delay so persistent failures do not busy-loop.
produce() {
	local line delay=1 produced
	rm -f "$out"
	pid=""
	trap '[ -z "$pid" ] || { kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; }' EXIT
	trap exit TERM INT HUP
	local owner=$BASHPID
	while true; do
		produced=""
		# Parent death also stops the group when shared receives SIGKILL, which
		# cannot run an EXIT trap. Keep the worker in Waybar's session.
		exec 6< <(exec setpriv --pdeathsig TERM "$0" --producer "$owner" "$script" 8>&-)
		pid=$!
		while IFS= read -r line <&6; do
			printf '%s\n' "$line" 2>/dev/null || exit
			printf '%s\n' "$line" >"$out.tmp" && mv -f "$out.tmp" "$out"
			produced=1
		done
		exec 6<&-
		wait "$pid" || true
		pid=""
		[ -z "$produced" ] || delay=1
		read -r -t "$delay" -u 7 _ || true
		delay=$((delay * 2 < 30 ? delay * 2 : 30))
	done
}

# A FIFO nobody writes to, so read -t waits without forking sleep. Opening it
# read-write does not block, and it can be unlinked once open.
mkfifo "$dir/$name.$$.fifo"
exec 7<>"$dir/$name.$$.fifo"
rm -f "$dir/$name.$$.fifo"

last=""
while true; do
	if flock -n 8; then
		produce
		exit
	fi
	# Poll the file every second and the lock every five. Both the file read
	# and the wait are builtins, $(<file) and sleep would fork every time.
	for _ in 1 2 3 4 5; do
		cur=""
		IFS= read -r -d '' cur <"$out" 2>/dev/null || true
		cur=${cur%$'\n'}
		if [ -n "$cur" ] && [ "$cur" != "$last" ]; then
			printf '%s\n' "$cur"
			last=$cur
		fi
		read -r -t 1 -u 7 _ || true
	done
done
